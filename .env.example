# --- Claude access: pick ONE engine --------------------------------------
# "api" = Anthropic API key | "cli" = Claude subscription via Claude Code CLI
ENGINE=api

# Only for ENGINE=api  (https://console.anthropic.com/ -> API keys)
ANTHROPIC_API_KEY=

# Only for ENGINE=cli (install Claude Code, run `claude` once to log in)
# CLI_MODEL=fable

# Model / output settings (defaults are fine)
# API_MODEL=claude-fable-5
# MAX_OUTPUT_TOKENS=32000
# EFFORT=medium

# --- Wiki (only needed to SAVE edits; dry runs work without) --------------
# Create at https://ml.wikipedia.org/wiki/Special:BotPasswords
WIKI_USERNAME=
WIKI_PASSWORD=
