# --- Claude access: pick ONE engine --------------------------------------
# "cli" = your Claude subscription via the Claude Code CLI — NO API key needed
#         (install Claude Code, run `claude` once to log in; that's it)
# "api" = Anthropic API key, pay per use — for large approved batch runs
ENGINE=cli

# Only for ENGINE=cli (optional; model alias passed to `claude -p`):
# fable | opus | sonnet. Whatever you set here MUST match the model disclosed
# on the project page for that batch — batch 3 ran on opus.
# CLI_MODEL=fable

# Only for ENGINE=api  (https://console.anthropic.com/ -> API keys)
# ANTHROPIC_API_KEY=

# Model / output settings (defaults are fine)
# API_MODEL=claude-fable-5
# MAX_OUTPUT_TOKENS=32000
# EFFORT=medium

# --- Wiki (only needed to SAVE edits; dry runs work without) --------------
# Create at https://ml.wikipedia.org/wiki/Special:BotPasswords
WIKI_USERNAME=YourName@botname
WIKI_PASSWORD=
#
# If you would rather not keep the password in this file, leave it blank
# and pass it in at run time from wherever you do keep it, e.g.
#   WIKI_PASSWORD="$(cat ~/secret)" python batchrun.py save --work ...
# Note Special:BotPasswords shows it as "botname@<password>";
# MediaWiki wants only the part AFTER the "@".

# --- API request pacing (see throttle.py) --------------------------------
# Anonymous ml.wikipedia access allows ~10 requests then a ~25s cooldown;
# logging in raises the limit a lot. Defaults are usually fine.
# REQUEST_INTERVAL=2.0
# REQUEST_INTERVAL_LOGGED_IN=0.4
